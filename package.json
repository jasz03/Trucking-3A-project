{
  "name": "trucking-operations",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/driver"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test": "node --experimental-strip-types --test apps/web/src/lib/*.test.ts && node scripts/test-database.mjs",
    "check": "npm run typecheck -w apps/web && npm run typecheck -w apps/driver"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "prettier": "^3.9.10"
  }
}
